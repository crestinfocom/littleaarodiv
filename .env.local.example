# ============================================================================
# Little Aarodiv local environment
# Copy this file to .env.local and fill in your values. NEVER commit .env.local.
# ============================================================================

# --- Database source for ALL development & testing work ---------------------
#   true  -> every dev/test read/write hits the LOCAL Docker Postgres (mirror)
#   false -> the API talks directly to the Neon database instead (no local)
USE_LOCAL_DB=true

# --- Local Docker Postgres (used when USE_LOCAL_DB=true) --------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=little_aarodiv
DB_PORT=5432
# Must match the docker-compose credentials above.
LOCAL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/little_aarodiv

# --- Neon source of truth ----------------------------------------------------
# Only touched by the explicit admin "Sync from Neon" action (or npm run sync:neon).
# Leave the Neon URL empty while developing locally: the sync button then reports
# "Neon not configured" instead of making any network calls.
# EXAMPLE -> postgresql://user:password@host-address.us-east-2.aws.neon.tech/dbname?sslmode=require
NEON_DATABASE_URL=
# The server also accepts the Vercel/Neon integration variable names, checked in
# this order: NEON_DATABASE_URL, DATABASE_URL_UNPOOLED, then DATABASE_URL. So you
# can paste a Neon integration block straight into a gitignored .env file.
#
# Master on/off switch for ALL Neon access. Set to false to run fully offline
# (e.g. while the Neon quota is exhausted): the sync action then reports
# "disabled" and makes no network calls at all.
NEON_SYNC_ENABLED=true

# --- Neon sync tuning (keeps Neon calls to a minimum while running locally) --
# Never sync more often than every NEON_SYNC_TTL_SECONDS unless the user forces it.
NEON_SYNC_TTL_SECONDS=86400
# Rows pulled + upserted per Neon round-trip. Incremental drives the per-table
# updated_at cursor, so busy tables converge in a bounded number of calls.
NEON_SYNC_BATCH_SIZE=500
# Seconds a sync may hold the single-flight lock before being rejected.
SYNC_LOCK_TIMEOUT_SECONDS=60

# --- API server --------------------------------------------------------------
API_PORT=4000